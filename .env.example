# The Linux installer (install.sh) writes the real .env for you. For manual setup, copy to .env and fill in.
# Keep values in single quotes. Never commit .env.
GC_EMAIL=''
GC_PASSWORD=''
# ntfy topic for alerts (keep private)
NTFY_TOPIC=''
# healthchecks.io ping URL
PING_URL=''
# To publish docs/data.json to GitHub after each update (the Linux box only):
PUBLISH=''
GIT_EMAIL=''
